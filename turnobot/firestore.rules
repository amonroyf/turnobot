rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función de ayuda: Verifica si el usuario autenticado es dueño del negocio
    function isOwner(slug) {
      return request.auth != null &&
             request.auth.uid == get(/databases/$(database)/documents/negocios/$(slug)).data.owner_uid;
    }

    // 1. Colección principal: NEGOCIOS
    match /negocios/{slug} {
      // Público: Los clientes necesitan leer el local para agendar
      allow read: if true;
      // Creación: el dueño autenticado crea el documento con su owner_uid
      allow create: if request.auth != null &&
                     request.resource.data.owner_uid == request.auth.uid;
      // Actualización y eliminación: solo el dueño
      allow update, delete: if request.auth != null &&
                     resource.data.owner_uid == request.auth.uid;

      // Subcolecciones: SERVICIOS y EMPLEADOS
      match /servicios/{servicioId} {
        allow read: if true;
        allow write: if isOwner(slug);
      }

      match /empleados/{empId} {
        allow read: if true;
        allow write: if isOwner(slug);
      }
    }

    // 2. Colección principal: RESERVAS
    match /reservas/{reservaId} {
      // Público: Cualquiera puede CREAR una reserva
      allow create: if true;

      // Privado: Solo el dueño del negocio puede leer, editar o eliminar sus reservas.
      // En read/get/list Firestore evalúa la regla por documento devuelto: comparamos el
      // negocio de la reserva contra el dueño autenticado vía get().
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid == get(/databases/$(database)/documents/negocios/$(resource.data.negocio_id)).data.owner_uid);
    }
  }
}
