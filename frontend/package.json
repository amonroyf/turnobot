{
  "name": "turnobot-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "E2E_TARGET=gcp E2E_ALLOW_GCP=1 playwright test",
    "test:e2e:local": "E2E_TARGET=local playwright test",
    "test:e2e:local:safe": "E2E_TARGET=local playwright test booking-pom.spec.js horarios.spec.js",
    "test:e2e:gcp": "E2E_TARGET=gcp E2E_ALLOW_GCP=1 playwright test",
    "test:e2e:gcp:safe": "E2E_TARGET=gcp E2E_ALLOW_GCP=1 playwright test booking-pom.spec.js booking.spec.js multi-tenant.spec.js demo-reserva.spec.js",
    "test:e2e:gcp:smoke": "E2E_TARGET=gcp E2E_ALLOW_GCP=1 SMOKE_PROD=1 playwright test smoke-prod.spec.js",
    "test:e2e:seed": "E2E_TARGET=gcp E2E_ALLOW_GCP=1 node e2e-tests/seed-gcp.mjs",
    "test:e2e:clean": "node e2e-tests/cleanup-staging.mjs",
    "test:e2e:ui": "E2E_TARGET=local playwright test --ui",
    "test:e2e:debug": "E2E_TARGET=local playwright test --debug",
    "test:e2e:headed": "E2E_TARGET=local playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "qa:harness": "node ../scripts/qa-harness-viewer.mjs --root .. --dir backend/test-reports",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.1.1",
    "allure-playwright": "^3.14.0",
    "firebase-admin": "^13.10.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
