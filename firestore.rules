rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Funciones de validación
    // ──────────────────────────────────────────────────────────────────────
    function isOwner(slug) {
      return request.auth != null &&
             request.auth.uid == get(/databases/$(database)/documents/negocios/$(slug)).data.owner_uid;
    }

    function isValidHHMM(h) {
      return h is string && h.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidTurno(t) {
      return t is map && t.keys().hasOnly(['inicio', 'fin']) && isValidHHMM(t.inicio) && isValidHHMM(t.fin);
    }

    function turnosValidos(turnos) {
      return turnos.size() >= 1 && turnos.size() <= 4 &&
             isValidTurno(turnos[0]) &&
             (turnos.size() < 2 || isValidTurno(turnos[1])) &&
             (turnos.size() < 3 || isValidTurno(turnos[2])) &&
             (turnos.size() < 4 || isValidTurno(turnos[3]));
    }

    function isValidDiaHorario(d) {
      return d is map && d.keys().hasOnly(['activo', 'turnos']) &&
             (d.activo == true || d.activo == false) && d.turnos is list &&
             (!d.activo || turnosValidos(d.turnos));
    }

    function isValidHorarioSemanal(h) {
      return h is map && h.keys().hasOnly(['lunes','martes','miercoles','jueves','viernes','sabado','domingo']) &&
             isValidDiaHorario(h.lunes) && isValidDiaHorario(h.martes) && isValidDiaHorario(h.miercoles) &&
             isValidDiaHorario(h.jueves) && isValidDiaHorario(h.viernes) && isValidDiaHorario(h.sabado) &&
             isValidDiaHorario(h.domingo);
    }

    function horarioIsValid() {
      return !request.resource.data.keys().hasAny(['horario']) ||
             request.resource.data.horario == null ||
             isValidHorarioSemanal(request.resource.data.horario);
    }

    // Un recurso: capacidad sana (1-100), servicio/empleado atados como
    // texto corto opcional y horario con la misma forma que el de empleados.
    // (Sin overbooking ni buffer: la capacidad es exacta.)
    function politicasRecursoValidas() {
      return (!('capacidad' in request.resource.data) ||
              (request.resource.data.capacidad is number &&
               request.resource.data.capacidad >= 1 &&
               request.resource.data.capacidad <= 100)) &&
             (!('servicio_id' in request.resource.data) ||
              (request.resource.data.servicio_id is string &&
               request.resource.data.servicio_id.size() <= 100)) &&
             (!('emp_id' in request.resource.data) ||
              (request.resource.data.emp_id is string &&
               request.resource.data.emp_id.size() <= 100)) &&
             (!('horario' in request.resource.data) ||
              request.resource.data.horario == null ||
              isValidHorarioSemanal(request.resource.data.horario));
    }

    // La marca del negocio (identidad visual + propósito): color hex o vacío,
    // textos acotados. El backend también sanea al escribir por API.
    function marcaValida() {
      return !('marca' in request.resource.data) ||
        (request.resource.data.marca is map &&
         (!('color' in request.resource.data.marca) ||
          request.resource.data.marca.color == '' ||
          (request.resource.data.marca.color is string &&
           request.resource.data.marca.color.matches('^#[0-9a-fA-F]{6}$'))) &&
         (!('eslogan' in request.resource.data.marca) ||
          (request.resource.data.marca.eslogan is string &&
           request.resource.data.marca.eslogan.size() <= 80)) &&
         (!('descripcion' in request.resource.data.marca) ||
          (request.resource.data.marca.descripcion is string &&
           request.resource.data.marca.descripcion.size() <= 500)) &&
         (!('instagram' in request.resource.data.marca) ||
          (request.resource.data.marca.instagram is string &&
           request.resource.data.marca.instagram.size() <= 120)) &&
         (!('facebook' in request.resource.data.marca) ||
          (request.resource.data.marca.facebook is string &&
           request.resource.data.marca.facebook.size() <= 120)) &&
         (!('tiktok' in request.resource.data.marca) ||
          (request.resource.data.marca.tiktok is string &&
           request.resource.data.marca.tiktok.size() <= 120)));
    }

    // Las políticas de reserva solo aceptan rangos sanos (el backend también
    // los acota; esto frena escrituras absurdas desde el SDK del dueño).
    function politicasValidas() {      return (!('cancel_window_hours' in request.resource.data) ||
              (request.resource.data.cancel_window_hours is number &&
               request.resource.data.cancel_window_hours >= 1 &&
               request.resource.data.cancel_window_hours <= 72)) &&
             (!('booking_window_days' in request.resource.data) ||
              (request.resource.data.booking_window_days is number &&
               request.resource.data.booking_window_days >= 1 &&
               request.resource.data.booking_window_days <= 365)) &&
             (!('max_bookings_per_phone_per_day' in request.resource.data) ||
              (request.resource.data.max_bookings_per_phone_per_day is number &&
               request.resource.data.max_bookings_per_phone_per_day >= 1 &&
               request.resource.data.max_bookings_per_phone_per_day <= 20)) &&
             (!('min_notice_minutes' in request.resource.data) ||
              (request.resource.data.min_notice_minutes is number &&
               request.resource.data.min_notice_minutes >= 0 &&
               request.resource.data.min_notice_minutes <= 10080));
    }

    // ──────────────────────────────────────────────────────────────────────
    // Colecciones
    // ──────────────────────────────────────────────────────────────────────

    // 1. Colección principal: NEGOCIOS
    match /negocios/{slug} {
      // Lectura RESTRINGIDA (antes pública): el doc puede traer restos de
      // campos sensibles de versiones viejas (push_token/push_tokens, hoy
      // migrados a privado/). La página pública lee por el API sanitizado;
      // el registro valida el enlace con GET /api/v1/b/{slug}/existe.
      // Solo dueño y super admin leen directo.
      allow read: if request.auth != null && (
        resource.data.owner_uid == request.auth.uid ||
        request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
      );
      // Creación: el dueño autenticado crea el documento con su owner_uid
      allow create: if request.auth != null &&
                     request.resource.data.owner_uid == request.auth.uid;

      // ACTUALIZACIÓN Y ELIMINACIÓN
      // El dueño NO puede modificar los campos 'suspended' ni 'suspended_at'.
      // Tampoco puede dejar políticas fuera de rango (se validan aquí y en Go).
      // El UID del Super Admin ('0FF1nrcBnSPIdB1rMgYocmRnYUb2') puede hacer todo.
      allow update: if request.auth != null && (
        (resource.data.owner_uid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended', 'suspended_at']) &&
         politicasValidas() && marcaValida())
        || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
      );

      allow delete: if request.auth != null && (
        resource.data.owner_uid == request.auth.uid ||
        request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
      );

      // Subcolección PRIVADA: tokens push del dueño y secretos del negocio.
      // Sin lectura pública ni de otros autenticados: solo dueño y super admin.
      // El backend Go usa Admin SDK (sin reglas) para leer/escribir aquí.
      match /privado/{docId} {
        allow read, write: if request.auth != null && (
          isOwner(slug) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
        );
      }

      // Subcolecciones: SERVICIOS y EMPLEADOS
      match /servicios/{servicioId} {
        allow read: if true;
        allow write: if isOwner(slug) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2';
      }

      // Subcolección RECURSOS (canchas, boxes, espacios): catálogo público
      // (nombre/tipo/capacidad, como servicios). La CREACIÓN pasa por el
      // backend (POST /api/v1/b/{slug}/recursos, Admin SDK sin reglas); el
      // dueño edita capacidad/horario/atados desde el panel.
      match /recursos/{recursoId} {
        allow read: if true;
        allow create: if false;
        allow update: if (isOwner(slug) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2') &&
          politicasRecursoValidas();
        allow delete: if isOwner(slug) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2';
      }

      match /empleados/{empId} {
        // SIN lectura pública: estos docs guardan refresh_token de Google y
        // hash login_pin. La página de reserva y el login leen empleados por
        // el API backend (sanitizado); el panel va autenticado como dueño.
        allow read: if isOwner(slug) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2';
        allow write: if (isOwner(slug) && horarioIsValid()) || request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2';
      }
    }

    // 2. Colección principal: RESERVAS (¡Optimizada y Blindada!)
    match /reservas/{reservaId} {
      // Bloqueo total: Ningún usuario puede crear citas desde el navegador. Solo el backend Go.
      allow create: if false;

      // Lectura: el dueño O el Super Admin (llaves maestras para el panel SaaS).
      // Escritura (update/delete): solo el dueño — el Super Admin muta vía
      // backend Go (Admin SDK, sin reglas), no hay path del frontend que lo necesite.
      allow read: if request.auth != null && (
        resource.data.owner_uid == request.auth.uid ||
        request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
      );
      allow update, delete: if request.auth != null && resource.data.owner_uid == request.auth.uid;
    }

    // 3. Colección principal: CLIENTES (CRM Optimizado)
    match /clientes/{clienteId} {
      allow create: if false; // Solo el backend actualiza métricas del CRM

      // Lectura: el dueño O el Super Admin (detalle del negocio en el panel SaaS).
      // Escritura: solo el dueño, mismo criterio que reservas.
      allow read: if request.auth != null && (
        resource.data.owner_uid == request.auth.uid ||
        request.auth.uid == '0FF1nrcBnSPIdB1rMgYocmRnYUb2'
      );
      allow update, delete: if request.auth != null && resource.data.owner_uid == request.auth.uid;
    }
  }
}
