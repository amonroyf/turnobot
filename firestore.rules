rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Funciones de validación
    // ──────────────────────────────────────────────────────────────────────
    function isOwner(slug) {
      return request.auth != null &&
             request.auth.uid == get(/databases/$(database)/documents/negocios/$(slug)).data.owner_uid;
    }

    function isValidHHMM(h) {
      return h is string && h.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidTurno(t) {
      return t is map && t.keys().hasOnly(['inicio', 'fin']) && isValidHHMM(t.inicio) && isValidHHMM(t.fin);
    }

    function turnosValidos(turnos) {
      return turnos.size() >= 1 && turnos.size() <= 4 &&
             isValidTurno(turnos[0]) &&
             (turnos.size() < 2 || isValidTurno(turnos[1])) &&
             (turnos.size() < 3 || isValidTurno(turnos[2])) &&
             (turnos.size() < 4 || isValidTurno(turnos[3]));
    }

    function isValidDiaHorario(d) {
      return d is map && d.keys().hasOnly(['activo', 'turnos']) &&
             (d.activo == true || d.activo == false) && d.turnos is list &&
             (!d.activo || turnosValidos(d.turnos));
    }

    function isValidHorarioSemanal(h) {
      return h is map && h.keys().hasOnly(['lunes','martes','miercoles','jueves','viernes','sabado','domingo']) &&
             isValidDiaHorario(h.lunes) && isValidDiaHorario(h.martes) && isValidDiaHorario(h.miercoles) &&
             isValidDiaHorario(h.jueves) && isValidDiaHorario(h.viernes) && isValidDiaHorario(h.sabado) &&
             isValidDiaHorario(h.domingo);
    }

    function horarioIsValid() {
      return !request.resource.data.keys().hasAny(['horario']) ||
             request.resource.data.horario == null ||
             isValidHorarioSemanal(request.resource.data.horario);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Colecciones
    // ──────────────────────────────────────────────────────────────────────

    // 1. Colección principal: NEGOCIOS
    match /negocios/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner_uid == request.auth.uid;

      match /servicios/{servicioId} {
        allow read: if true;
        allow write: if isOwner(slug);
      }

      match /empleados/{empId} {
        allow read: if true;
        allow write: if isOwner(slug) && horarioIsValid();
      }
    }

    // 2. Colección principal: RESERVAS (¡Optimizada y Blindada!)
    match /reservas/{reservaId} {
      // Bloqueo total: Ningún usuario puede crear citas desde el navegador. Solo el backend Go.
      allow create: if false;

      // Lectura hiper-rápida y económica: Validación condicional directa de la propiedad.
      allow read, update, delete: if request.auth != null && resource.data.owner_uid == request.auth.uid;
    }

    // 3. Colección principal: CLIENTES (CRM Optimizado)
    match /clientes/{clienteId} {
      allow create: if false; // Solo el backend actualiza métricas del CRM
      allow read, update, delete: if request.auth != null && resource.data.owner_uid == request.auth.uid;
    }
  }
}
